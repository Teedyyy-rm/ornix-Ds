# Secrets and credentials — never committed.
.env
.env.*
!.env.example

# Run state. SQLite is the authoritative run state (ADR 0007) and is never
# committed; it is reproducible from raw bytes plus recipes.
*.db
*.db-wal
*.db-shm
state/

# Artifacts.
raw/
master/
views/
release/
work/
artifacts/
*.wav
*.flac
*.mp3
*.ogg
*.m4a

# Model weights. Pinned by revision and sha256 in configs/models.lock.yaml;
# the binaries themselves are not source.
models/
*.onnx
*.onnx.data
*.bin
*.pt
*.pth
*.ckpt

# Python.
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tooling caches.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
uv.lock.bak

# Local overrides. Versioned configs live in configs/; local overrides do not.
configs/**/*.local.yaml
configs/*.local.yaml

# Editors / OS.
.idea/
.vscode/
.DS_Store

# Bootstrap scratch. The ornix-tts wheel is built here from a copy of the
# read-only downstream checkout (docs/OPERATIONS.md 1a). Never committed.
bootstrap/
